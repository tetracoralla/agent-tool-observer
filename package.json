{
  "name": "@openadam/agent-tool-observer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-only passive observation of Agent tool usage across supported clients.",
  "license": "Apache-2.0",
  "author": "openAdam",
  "homepage": "https://github.com/tetracoralla/agent-tool-observer",
  "repository": { "type": "git", "url": "https://github.com/tetracoralla/agent-tool-observer.git" },
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "agent-tool-observer": "src/cli.mjs"
  },
  "scripts": {
    "test": "node --no-warnings --test test/*.test.mjs",
    "check:contracts": "node --no-warnings scripts/check-contracts.mjs",
    "check:release": "node --no-warnings scripts/check-public-release.mjs",
    "smoke": "node --no-warnings scripts/smoke.mjs",
    "check": "npm test && npm run check:contracts && npm run check:release && npm run smoke"
  }
